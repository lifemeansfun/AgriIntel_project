{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/dist/**": true,
    "**/data/**": true,
    "**/scratch/**": true,
    "**/.system_generated/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/dist": true,
    "**/data": true,
    "**/scratch": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true
  },
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsserver.maxTsServerMemory": 1024,
  "editor.largeFileOptimizations": true
}
